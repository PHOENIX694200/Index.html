<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>World Tourism Day - Asia Digital Itinerary App</title>
  <style>
    * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: #f4f7f6; margin: 0; padding: 20px; color: #333; }
    .container { max-width: 900px; margin: 0 auto; background: #fff; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
    h1 { color: #0d5c75; text-align: center; margin-bottom: 5px; }
    p.subtitle { text-align: center; color: #666; margin-bottom: 25px; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px; }
    .form-group { display: flex; flex-direction: column; }
    label { font-weight: 600; margin-bottom: 8px; color: #444; }
    select, input { padding: 12px; border: 1fr solid #ccc; border-radius: 6px; font-size: 15px; }
    button.btn-generate { width: 100%; background-color: #0d5c75; color: white; border: none; padding: 14px; font-size: 16px; font-weight: bold; border-radius: 6px; cursor: pointer; transition: 0.3s; }
    button.btn-generate:hover { background-color: #094356; }
    .results-section { margin-top: 35px; display: none; }
    .itinerary-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    .itinerary-table th, .itinerary-table td { border: 1px solid #ddd; padding: 12px; text-align: left; }
    .itinerary-table th { background-color: #e6f2f5; color: #0d5c75; }
    .badge { background: #e0f2fe; color: #0369a1; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
    .actions { margin-top: 20px; text-align: right; }
    .btn-print { background: #27ae60; color: white; border: none; padding: 10px 18px; border-radius: 6px; cursor: pointer; font-weight: bold; }
  </style>
</head>
<body>

<div class="container">
  <h1>🌍 Asia Travel Itinerary Generator</h1>
  <p class="subtitle">World Tourism Day Celebration Project</p>

  <form id="itineraryForm">
    <div class="form-grid">
      <div class="form-group">
        <label for="destination">Asian Destination / Country</label>
        <select id="destination" required>
          <option value="">Select Destination</option>
          <option value="Japan">Japan</option>
          <option value="Thailand">Thailand</option>
          <option value="India">India</option>
          <option value="Indonesia">Indonesia (Bali)</option>
          <option value="Vietnam">Vietnam</option>
          <option value="Sri Lanka">Sri Lanka</option>
          <option value="Nepal">Nepal</option>
        </select>
      </div>

      <div class="form-group">
        <label for="gender">Type of Traveller</label>
        <select id="gender" required>
          <option value="Male">Male</option>
          <option value="Female">Female</option>
        </select>
      </div>

      <div class="form-group">
        <label for="purpose">Purpose of Visit</label>
        <select id="purpose" required>
          <option value="Sports & Adventure">Sports & Adventure</option>
          <option value="Spiritual Tourism">Spiritual Tourism</option>
          <option value="Leisure">Leisure</option>
          <option value="Yoga & Wellness">Yoga & Wellness</option>
          <option value="Health Tourism">Health Tourism</option>
        </select>
      </div>

      <div class="form-group">
        <label for="days">Number of Days (1-7)</label>
        <input type="number" id="days" min="1" max="7" value="3" required>
      </div>
    </div>

    <button type="submit" class="btn-generate">Generate Custom Itinerary</button>
  </form>

  <div id="results" class="results-section">
    <hr style="border:0; border-top:1px solid #eee; margin:20px 0;">
    <h2 id="resultTitle" style="color: #0d5c75;">Customized Itinerary</h2>
    <p id="resultMeta"></p>

    <table class="itinerary-table">
      <thead>
        <tr>
          <th>Day</th>
          <th>Time Slot</th>
          <th>Activity & Highlights</th>
        </tr>
      </thead>
      <tbody id="itineraryBody"></tbody>
    </table>

    <div class="actions">
      <button class="btn-print" onclick="window.print()">Print / Save PDF</button>
    </div>
  </div>
</div>

<script>
  // Activity Database tailored for Asian Continent & Purpose
  const activityData = {
    "Sports & Adventure": [
      { morning: "Trekking / Trail Exploration", afternoon: "Water Sports / Ziplining", evening: "Campfire & Outdoor Social" },
      { morning: "Mountain Biking Excursion", afternoon: "White Water Rafting", evening: "Local Night Market Exploration" },
      { morning: "Rock Climbing Session", afternoon: "ATV Jungle Safari", evening: "Sunset Viewpoint Hike" }
    ],
    "Spiritual Tourism": [
      { morning: "Morning Temple / Shrine Visit", afternoon: "Guided Cultural Heritage Tour", evening: "Evening Prayer & Chanting Ceremony" },
      { morning: "Meditation at Ancient Monastery", afternoon: "Sacred River / Site Visit", evening: "Cultural Spiritual Performance" },
      { morning: "Pilgrimage Route Walking Tour", afternoon: "Philosophical & Historical Lecture", evening: "Lantern Lighting Experience" }
    ],
    "Leisure": [
      { morning: "Relaxed Breakfast & City Walk", afternoon: "Shopping & Local Cuisine Tasting", evening: "Sunset Cruise & Dinner" },
      { morning: "Museum & Art Gallery Visit", afternoon: "Cafe Hopping & Souvenir Shopping", evening: "Traditional Music Show" },
      { morning: "Scenic Park / Botanical Garden Visit", afternoon: "Local Craft Workshop", evening: "Rooftop Dining Experience" }
    ],
    "Yoga & Wellness": [
      { morning: "Sunrise Pranayama & Hatha Yoga", afternoon: "Organic Plant-based Lunch & Spa", evening: "Guided Sound Bath & Meditation" },
      { morning: "Vinyasa Flow & Breathwork Class", afternoon: "Herbal Bath & Hydrotherapy", evening: "Mindful Forest Walking Tour" },
      { morning: "Detox Yoga & Chakra Healing", afternoon: "Ayurvedic Massages", evening: "Sunset Tea Ceremony & Reflection" }
    ],
    "Health Tourism": [
      { morning: "Health Check-up & Consultation", afternoon: "Therapeutic Hydrotherapy Session", evening: "Nutritional Advisory & Rest" },
      { morning: "Holistic Physical Therapy", afternoon: "Herbal Treatment & Body Recovery", evening: "Relaxing Botanical Walk" },
      { morning: "Post-Treatment Wellness Followup", afternoon: "Meditation & Mind Rest Routine", evening: "Light Wellness Cuisine Dinner" }
    ]
  };

  document.getElementById('itineraryForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const dest = document.getElementById('destination').value;
    const gender = document.getElementById('gender').value;
    const purpose = document.getElementById('purpose').value;
    const days = parseInt(document.getElementById('days').value);

    const resultBody = document.getElementById('itineraryBody');
    resultBody.innerHTML = '';

    const templates = activityData[purpose];
    
    for (let i = 1; i <= days; i++) {
      const dayTemplate = templates[(i - 1) % templates.length];
      
      const row = `
        <tr>
          <td rowspan="3" style="font-weight:bold; vertical-align:top; background:#fafafa;">Day ${i}</td>
          <td><span class="badge">Morning</span></td>
          <td>${dayTemplate.morning} in ${dest}</td>
        </tr>
        <tr>
          <td><span class="badge">Afternoon</span></td>
          <td>${dayTemplate.afternoon}</td>
        </tr>
        <tr>
          <td><span class="badge">Evening</span></td>
          <td>${dayTemplate.evening}</td>
        </tr>
      `;
      resultBody.innerHTML += row;
    }

    document.getElementById('resultTitle').innerText = `Itinerary for ${dest}`;
    document.getElementById('resultMeta').innerText = `Traveller: ${gender} | Purpose: ${purpose} | Duration: ${days} Day(s)`;
    document.getElementById('results').style.display = 'block';
  });
</script>

</body>
</html>
